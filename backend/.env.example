# Copy to .env and fill in. Only MISTRAL_API_KEY is required.
MISTRAL_API_KEY=your_mistral_api_key
MINDPALACE_CHAT_MODEL=mistral-large-latest
MINDPALACE_VISION_MODEL=pixtral-12b-2409
MINDPALACE_DB=./mindpalace.db
MINDPALACE_UPLOADS=./uploads
# Reverse-geocode GPS to place names via OpenStreetMap (needs internet). Off by default.
ENABLE_GEOCODING=false
